// Flashing Lights Machine Code
// This is the machine code for the flashing lights example program
// Format: Address(Hex) : Opcode(Binary) // Opcode(Hex) // Corresponding Mnemonic

0x00 : 00000111 // 0x07 // DATA Ra
0x01 : 10000000 // 0x80 // #0x80

0x02 : 00000111 // 0x07 // DATA Ra
0x03 : 01000000 // 0x40 // #0x40

0x04 : 00000111 // 0x07 // DATA Ra
0x05 : 00100000 // 0x20 // #0x20

0x06 : 00000111 // 0x07 // DATA Ra
0x07 : 00010000 // 0x10 // #0x10

0x08 : 00000111 // 0x07 // DATA Ra
0x09 : 00001000 // 0x08 // #0x08

0x0a : 00000111 // 0x07 // DATA Ra
0x0b : 00000100 // 0x04 // #0x04

0x0c : 00000111 // 0x07 // DATA Ra
0x0d : 00000010 // 0x02 // #0x02

0x0e : 00000111 // 0x07 // DATA Ra
0x0f : 00000001 // 0x01 // #0x01

0x10 : 00101111 // 0x2f // JMP
0x11 : 00000000 // 0x00 // #0
